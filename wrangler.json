{
  "name": "api-gateway-preview",
  "main": "src/main.py",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["python_workers"],
  "port": 8788,
  "vars": {
    "APP_ENV": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thrj-blogs-dev",
      "database_id": "72ef27fc-f1e1-4f7b-a673-09f27d8dc7ce"
    }
  ],
  "env": {
    "production": {
      "name": "api-gateway-production",
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "thrj-blogs",
          "database_id": "6d73e553-f1dc-42f2-a5b8-27f4cc9d8622"
        }
      ]
    }
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}